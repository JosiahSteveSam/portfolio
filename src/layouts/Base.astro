---
import '../styles/site.css';
import { site, heroStandIn } from '../data/site';

interface Props {
  title: string;
  description: string;
  current?: 'work';
}
const { title, description, current } = Astro.props;
const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${home}#work`, label: 'Work', key: 'work' },
  { href: `${home}#engineering`, label: 'Engineering' },
  { href: `${home}#experience`, label: 'Experience' },
  { href: `${home}#about`, label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,800&family=IBM+Plex+Mono:wght@400&family=Newsreader:opsz,wght@6..72,400;6..72,600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="grid-paper" aria-hidden="true">
      <div class="container"><div class="grid-paper__cols">{Array.from({ length: 12 }, () => <span />)}</div></div>
    </div>

    <header class="nav container">
      <a class="wordmark" href="/" aria-label="Josiah Steve Sam, home">Josiah Steve Sam</a>
      <nav aria-label="Sections">
        <ul class="nav__links">
          {links.map((l) => (
            <li class={l.key ? undefined : 'nav__secondary'}>
              <a href={l.href} aria-current={l.key && l.key === current ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
          <li><a href={`mailto:${site.email}`}>Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer" id="contact">
      <div class="container">
        <h2 class="footer__head">Write to Josiah</h2>
        <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
        <dl class="footer__facts">
          <div><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={site.github}>JosiahSteveSam</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={site.linkedin}>josiah-ds</a></dd></div>
          <div>
            <dt>Resumes</dt>
            <dd><a href={site.resumePrimary}>Full stack and AI (PDF)</a></dd>
            <dd><a href={site.resumeAI}>AI engineer (PDF)</a></dd>
          </div>
        </dl>
        <p class="footer__small" data-credits>Photographs: <Fragment set:html={heroStandIn.creditHtml} /></p>
        <p class="footer__small">Josiah Steve Sam, 2026. Chennai, India.</p>
      </div>
    </footer>

    <script is:inline>
      window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
      document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
